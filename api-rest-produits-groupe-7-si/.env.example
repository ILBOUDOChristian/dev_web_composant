# ==============================================================================
# API REST PRODUITS — Groupe 7 SI — Modèle de configuration d'environnement
# ==============================================================================
# RÈGLE ACADÉMIQUE : Ce fichier est versionné dans Git et sert de gabarit.
# Pour déployer, copier ce fichier vers '.env' :
#   PowerShell : Copy-Item .env.example .env
#   Bash       : cp .env.example .env
# Le fichier '.env' est strictement ignoré par Git (sécurité des credentials).
# Toutes les valeurs ci-dessous sont fonctionnelles par défaut pour un test local.
# ==============================================================================

# --- IDENTIFICATION DE L'ÉQUIPE ---
# GROUPE_EQUIPE : Numéro attribué à l'équipe sur la liste officielle.
GROUPE_EQUIPE=7

# --- ARCHITECTURE DU PROJET ---
# Thème 10 : API REST de produits avec Python (FastAPI), PostgreSQL et WSO2 MI.
# Flux : Insomnia -> WSO2 Micro Integrator -> PostgreSQL (source + cible) <- API Python CRUD
#
# La base PostgreSQL contient UNE seule base physique (products_db) et deux schémas :
#   source.products : produits d'origine utilisés par le flux WSO2 ;
#   cible.products  : produits transférés et exposés par l'API Python.

# ==============================================================================
# SECTION 1 — PORTS EXPOSÉS SUR LA MACHINE HÔTE (FORWARDÉS DEPUIS DOCKER)
# ==============================================================================
# RÈGLE IMPORTANTE : Ne jamais modifier les ports internes des conteneurs
# (5432, 8000, 8290, 80). Seuls les ports hôtes ci-dessous peuvent être changés
# en cas de conflit.
#
# Vérifier les conflits avant démarrage (PowerShell) :
#   Get-NetTCPConnection -LocalPort 5434,8001,8291,3001,5050 -ErrorAction SilentlyContinue
#
# Tableau des correspondances :
#   Service         Port hôte   Port interne (Docker)
#   PostgreSQL      5434        5432   (5434 car 5432 déjà utilisé sur Windows)
#   pgAdmin (UI)    5050        80
#   API Python      8001        8000
#   WSO2 MI         8291        8290
#   Interface web   3001        80
#
POSTGRES_HOST_PORT=5434
PGADMIN_HOST_PORT=5050
BACKEND_HOST_PORT=8001
WSO2_HTTP_HOST_PORT=8291
FRONTEND_HOST_PORT=3001

# ==============================================================================
# SECTION 2 — PARAMÈTRES POSTGRESQL (SERVICE docker : "db")
# ==============================================================================
# Ces variables configurent le conteneur PostgreSQL 16-alpine.
# Le volume 'postgres-data' persiste les données entre les redémarrages.
# Elles sont utilisées à la fois par Docker pour initialiser la base
# et par le backend Python / WSO2 pour s'y connecter depuis l'intérieur du réseau Compose.
#
POSTGRES_DB=products_db
POSTGRES_USER=products_user
POSTGRES_PASSWORD=change_me

# ==============================================================================
# SECTION 3 — CONNEXION BASE DE DONNÉES — BACKEND PYTHON (SERVICE : "backend")
# ==============================================================================
# Utilisé par l'API FastAPI pour se connecter à PostgreSQL depuis l'intérieur
# du réseau Docker Compose. DB_HOST DOIT rester "db" (nom du service Compose),
# jamais "localhost".
#
DB_HOST=db
DB_PORT=5432
DB_NAME=products_db
DB_USER=products_user
DB_PASSWORD=change_me

# ==============================================================================
# SECTION 4 — CONNEXION BASE DE DONNÉES — WSO2 MICRO INTEGRATOR (SERVICE : "wso2")
# ==============================================================================
# Utilisé par les séquences WSO2 (DBLookup / DBReport) pour lire source.products
# et écrire dans cible.products. WSO2_DB_HOST DOIT rester "db", jamais "localhost".
#
WSO2_DB_HOST=db
WSO2_DB_PORT=5432
WSO2_DB_NAME=products_db
WSO2_DB_USER=products_user
WSO2_DB_PASSWORD=change_me
# Mot de passe du keystore JKS embarqué dans l'image WSO2 (wso2carbon.jks).
WSO2_KEYSTORE_PASSWORD=change_me

# ==============================================================================
# SECTION 5 — CORS ET ACCÈS FRONTEND (SERVICE : "frontend")
# ==============================================================================
# CORS_ALLOWED_ORIGINS : liste des origines autorisées par l'API Python.
# Adapter si le port hôte du frontend est modifié dans FRONTEND_HOST_PORT.
#
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ==============================================================================
# SECTION 6 — URL PUBLIQUE POUR LES TESTS CLIENTS (INSOMNIA / CURL)
# ==============================================================================
# URL de base de l'API Python exposée sur l'hôte.
# Variables d'environnement Insomnia à configurer :
#   python_base_url = http://localhost:8001
#   wso2_base_url   = http://localhost:8291
#
PYTHON_BASE_URL=http://localhost:8001
WSO2_BASE_URL=http://localhost:8291

# ==============================================================================
# DÉMARRAGE RAPIDE (POWERSHELL — DEPUIS LA RACINE DU PROJET)
# ==============================================================================
# 1. Copier ce fichier :
#      if (-not (Test-Path .env)) { Copy-Item .env.example .env }
# 2. Éditer .env et remplacer toutes les occurrences de "change_me".
# 3. Lancer l'assemblage complet :
#      docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build
# 4. Vérifier l'état des services :
#      docker compose -f docker-compose.yml -f docker-compose.dev.yml ps
# Résultat attendu : db → healthy | backend → healthy | wso2 → started | frontend → accessible
# ==============================================================================
